{
  "name": "senna-chat-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "test": "tsx --test src/**/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "db:migrate:prod": "node dist/migrate.js",
    "rns:reset-index": "tsx src/rns/reset-index.ts",
    "rns:reset-index:prod": "node dist/rns/reset-index.js",
    "rns:reconcile-labels": "tsx src/rns/reconcile-labels.ts",
    "rns:reconcile-labels:prod": "node dist/rns/reconcile-labels.js",
    "rns:check-mainnet": "tsx src/rns/check-mainnet-readiness.ts",
    "rns:check-mainnet:prod": "node dist/rns/check-mainnet-readiness.js",
    "docs:sync": "sh -c 'if [ -f dist/sync/gitbook.js ]; then node dist/sync/gitbook.js; else tsx src/sync/gitbook.ts; fi'"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.0.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.3.1",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "viem": "^2.52.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
