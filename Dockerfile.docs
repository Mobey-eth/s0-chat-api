FROM nginx:1.27-alpine

COPY developer-docs/nginx.conf /etc/nginx/conf.d/default.conf
COPY developer-docs/index.html /usr/share/nginx/html/index.html
COPY developer-docs/styles.css /usr/share/nginx/html/styles.css
COPY developer-docs/app.js /usr/share/nginx/html/app.js
COPY developer-docs/openapi.yaml /usr/share/nginx/html/openapi.yaml

EXPOSE 80
